{
  "name": "@0xpv/claude-share",
  "version": "1.3.2",
  "description": "Share or connect to a friend's Claude Code subscription",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "share",
    "proxy"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-share": "dist/claude-share/index.js",
    "claude-connect": "dist/claude-connect/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamVaidya/claude-share.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev:share": "bun claude-share/index.ts",
    "dev:connect": "bun claude-connect/index.ts",
    "dev:manager": "bun manager/index.ts",
    "start:share": "node dist/claude-share/index.js",
    "start:connect": "node dist/claude-connect/index.js",
    "start:manager": "node dist/manager/index.js",
    "lint": "oxlint claude-share/src claude-connect/src shared",
    "fmt": "oxfmt --config .oxfmtrc.json claude-share/src claude-connect/src shared",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@hono/node-server": "^2.0.1",
    "@noble/ciphers": "^2.2.0",
    "hono": "^4.12.16",
    "http-mitm-proxy": "^1.1.0",
    "ink": "^7.0.1",
    "node-forge": "^1.4.0",
    "react": "^19.2.5"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "latest",
    "@types/node-forge": "1.3.14",
    "@types/react": "latest",
    "@types/semaphore": "1.1.4",
    "@types/ws": "8.18.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "latest"
  }
}
